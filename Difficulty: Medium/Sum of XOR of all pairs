class Solution {
  public:
    long long sumXOR(vector<int> &arr) {
        long long n= arr.size();
        long long ans =0;
        if(n==1){
            return 0;
        }
        else{
            long long  i=0;
            while(i<n){
                long long xr = 0;
                long long j =i+1;
                    while(j<n){
                        xr = arr[i]^arr[j];
                        ans+=xr;
                        j++;
                    }
                i++;
            }
            
        }
       return ans; 
    }
};
