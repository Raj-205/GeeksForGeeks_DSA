class Solution {
  public:
    int kthMissing(vector<int> &arr, int k) {
       int n = arr.size();
       int miss[n];
       for(int i=1;i<=n;i++){
           miss[i-1] = arr[i-1] - i;
       }
       int low = 0;
       int high = n-1;
       while( low<=high){
           int mid = low + (high - low)/2;
           if(miss[mid]< k){
               low = mid +1;
           }
           else{
               high = mid -1;
           }
       }
       return (arr[high] + k-miss[high]);
    }
};
