class Solution {
  public:
    double power(double b, int e) {
               long long N = e;
               double ans = 1.0;
               if (N<0){
                   b= 1/b;
                   N =-N;
               }
               while(N>0){
                   if (N%2==1){
                       ans*=b;
                   }
                  b*=b;
                  N/=2;
               }
               return ans ;
           }
};
   
