class Solution {
  public:
    int kokoEat(vector<int>& piles, int h) {
        int n = piles.size();
        int low =1;
        int mid=0;
        int high = *max_element(piles.begin(), piles.end());
        while(low<= high){
            long long total =0;
            mid = low + (high-low)/2;
            for( int i =0; i< piles.size(); i++){
                total+= (piles[i]+mid-1)/mid;
            }
            if(total<=h){
              high = mid -1;
            }
            else{
               low = mid+1; 
            }
        }
        return low;
    }
};
