class Solution {
  public:
    int aggressiveCows(vector<int> &arr, int k) {
        sort(arr.begin(),arr.end());
        int n= arr.size();
        int low =1;
        int high = *max_element(arr.begin(),arr.end())-*min_element(arr.begin(),arr.end());
        while(low<=high){
            int mid = low + (high -low)/2;
            int cows =1;
            int last = arr[0];
            for( int i=1;i<n;i++){
                if(arr[i]- last >= mid){
                    cows++;
                    last = arr[i];
                } 
            }
            if(cows>= k){
                low = mid+1;
            }
            else{
                high = mid-1;
            }
        }
        return high;
    }
};
