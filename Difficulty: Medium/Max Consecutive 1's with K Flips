class Solution {
  public:
    int maxOnes(vector<int>& arr, int k) {
       int n = arr.size();
       int l=0;
       int r=0;
       int maxlen =0;
       int zero =0;
       while(r<n){
           if(arr[r]==0) zero++;
           while(zero>k){
               if(arr[l]==0)zero--;
               l++;
           }
           maxlen = max(maxlen , r-l+1);
           r++;
       }
        return maxlen;
    }
};
