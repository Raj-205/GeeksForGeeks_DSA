class Solution {
  public:
    int numberOfSubarrays(vector<int>& arr, int target) {
        return (ans(arr, target)- ans(arr,target-1));
    }
    int ans (vector<int>& nums, int goal){
        int n=nums.size();
        int l=0,r=0,sum=0, count=0;
        while (r<n){
            if (goal < 0) return 0;
            sum+=nums[r];
            while(sum>goal){
                sum-=nums[l]; 
                l++;
            }
            count+= r-l+1;
            r++;
        } 
        return count;
    }
};
