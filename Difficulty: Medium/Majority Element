class Solution {
  public:
    int majorityElement(vector<int>& arr) {
      int count =0, ele;
            for(int i=0;i<arr.size();i++){
                if(count==0){
                 count++;
                 ele= arr[i];
                }
                else if(arr[i]==ele){
                    count++;
                }
                else{
                    count--;
                }

            }
            int freq = 0;
                   for(int x : arr){
                       if(x == ele) freq++;
                   }
                   return (freq > arr.size()/2) ? ele : -1; 
        }  
        
    
};
