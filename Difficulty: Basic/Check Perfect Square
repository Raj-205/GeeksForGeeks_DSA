class Solution {
  public:
    bool isPerfectSquare(int x) {
        if(x== 0) return 0;
        int low =1;
        int high = x;
        while(low<= high){
        int mid = low+ (high-low)/2;
        if ((long long )mid*mid == x ){
            return true;
        }
         if ((long long )mid*mid < x ){
             low = mid +1;
        }
        else{
            high = mid - 1;
        }
        }
    return false ;
    }
};
