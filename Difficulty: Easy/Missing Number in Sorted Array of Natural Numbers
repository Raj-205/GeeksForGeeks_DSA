class Solution {
  public:
    int missingNumber(vector<int>& arr) {
           int n = arr.size();
           int l = 0; 
           int r = n - 1;
           while(l <= r) {
               int mid = l + (r - l) / 2;
               if(arr[mid] == mid + 1) {
                   l = mid + 1;
               } else {
                   r = mid - 1;
               }
           }
           return l + 1;
       }
};
