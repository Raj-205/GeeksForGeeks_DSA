class Solution {
  public:
    string convertToRoman(int n) {
        string ans;
        vector<int> value = {
                    1000, 900, 500, 400,
                    100, 90, 50, 40,
                    10, 9, 5, 4, 1
                };

        vector<string> symbol = {
                    "M", "CM", "D", "CD",
                    "C", "XC", "L", "XL",
                    "X", "IX", "V", "IV", "I"
                };
        
        for(int i=0;i<value.size();i++){
            while(n>= value[i]){
                ans+=symbol[i];
                n-=value[i];
            }
        }
        return ans;
    }
};
